# CRA/react-scripts treats ESLint warnings as build-failing errors when
# CI=true, which Vercel (and some other CI hosts) set by default for every
# build. This repo has a number of pre-existing lint warnings (unused
# vars, missing hook deps, etc.) that don't affect runtime behavior. Keep
# them as warnings, not build failures, on any host.
#
# This file is intentionally committed (unlike .env / .env.local, which
# are gitignored) -- CRA's own convention for non-secret, build-time
# config that should ship with the repo.
CI=false
