# Copy to .env (never commit .env)

PORT=5000
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/dbname?retryWrites=true&w=majority
JWT_SECRET=use_a_long_random_string_at_least_32_chars

# Brevo SMTP relay (free tier: https://app.brevo.com/settings/keys/smtp).
# Used for OTP + password-reset emails. EMAIL_USER = the "SMTP login" shown
# there, EMAIL_PASS = the generated "SMTP key" (not your Brevo account
# password). Override EMAIL_HOST/EMAIL_PORT to use a different provider.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=your_brevo_smtp_login
EMAIL_PASS=your_brevo_smtp_key
# Sender address shown to recipients — must be a verified sender in Brevo.
EMAIL_FROM=your_verified_sender@example.com

# Comma-separated browser origins for CORS
CLIENT_ORIGIN=http://localhost:3000,http://localhost:5000

# Base URL used to build password-reset links emailed to users
# (defaults to the first CLIENT_ORIGIN entry if unset)
CLIENT_URL=http://localhost:3000

# Optional bind (default 0.0.0.0 — use for Render)
# HOST=0.0.0.0
