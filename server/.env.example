# Copy to .env (never commit .env)

PORT=5000
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/dbname?retryWrites=true&w=majority
JWT_SECRET=use_a_long_random_string_at_least_32_chars

EMAIL_USER=your_email@example.com
EMAIL_PASS=your_app_password

# Comma-separated browser origins for CORS
CLIENT_ORIGIN=http://localhost:3000,http://localhost:5000

# Optional bind (default 0.0.0.0 — use for Render)
# HOST=0.0.0.0
