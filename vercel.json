{
  "version": 2,
  "builds": [
    { "src": "server/server.js", "use": "@vercel/node" },
    { "src": "client/package.json", "use": "@vercel/static-build", "config": { "distDir": "build" } }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server/server.js" },
    { "src": "/swagger/(.*)", "dest": "server/server.js" },
    { "src": "/static/(.*)", "dest": "client/static/$1" },
    { "src": "/(favicon\\.ico|manifest\\.json|robots\\.txt|asset-manifest\\.json|logo192\\.png|logo512\\.png)", "dest": "client/$1" },
    { "src": "/(.*)", "dest": "client/index.html" }
  ]
}
